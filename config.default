# Copied to /data/adb/br77/config on first boot. Edit that copy, then reboot.
# DHCP uses a /24. Only the last number of DHCP_START and DHCP_END is used.

BRIDGE=br77
ADDR=192.168.77.1
PREFIX=24
DHCP_START=192.168.77.10
DHCP_END=192.168.77.200

# auto: USB gadget (rndis/usb/ncm), AP interfaces reported by iw, and
# softap/ap/ap_br/bt-pan names. A space-separated list forces those names only.
PORTS=auto

# 1: if a cable is configured and the gadget is not already rndis or ncm,
# switch to USB tethering. adb stays. 0: do not change USB mode.
AUTO_USB=1

# 1: advertise the current upstream global /64 on the bridge.
IPV6=1
